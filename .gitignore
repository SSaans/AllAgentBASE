# Git 忽略规则

# ============================================
# 操作系统生成的文件
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ============================================
# 编辑器和 IDE
# ============================================
# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains 系列（PyCharm, WebStorm 等）
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ============================================
# 编程语言相关
# ============================================
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/
*.egg

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Java
*.class
*.jar
*.war
target/

# C/C++
*.o
*.obj
*.exe
*.out
*.so
*.dll

# ============================================
# 项目配置和敏感信息
# ============================================
# 环境变量文件
.env
.env.local
.env.*.local

# 配置文件（可能包含密码）
config.local.*
secrets.json
credentials.json

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 日志文件
*.log
logs/
log/

# ============================================
# 临时文件和缓存
# ============================================
# 临时文件夹
temp/
tmp/
cache/
.cache/

# 备份文件
*.bak
*.backup
*.old

# ============================================
# 构建产物
# ============================================
# 编译输出
dist/
build/
out/
*.min.js
*.min.css

# ============================================
# 测试相关
# ============================================
# 测试覆盖率报告
coverage/
.nyc_output/
htmlcov/
.coverage

# ============================================
# 其他
# ============================================
# 压缩文件（根据需要调整）
# *.zip
# *.rar
# *.7z

# 大文件（根据需要调整）
# *.mp4
# *.avi
# *.mov

# ============================================
# 仓库根的本机产物 —— 一律不入仓（2026-09-22 归并升级）
# ============================================
# 本仓库根**同时是 Agent 的工作区根**。在仓库根跑 Agent / 建项目时，宿主目录与
# 项目克隆会「自然落在仓库里」—— 它们不属于本仓库，只是恰好在这建的。
# 顶层白名单与强制纪律见 AGENTS.md 的「🔒 入库收件范围」节。
# ⚠️ 新宿主 / 新产物出现时**当场补规则**（把被动防御变成主动规则）。

# -- Agent 宿主本地目录（各家命名不同，按需扩充）--
# `.claude/skills/distilly` 单目录即 3000+ 文件，一旦误提交会污染仓库
.claude/
.workbuddy/
.codex/
.cursor/
.windsurf/
.continue/
.cline/
.roo/
.gemini/
.qwen/
.trae/
.aider*
.claude-flow/

# -- 在仓库根建项目产生的克隆副本 / 宿主工作区数据 --
# 成因举例：脚本里 D:\Program\distilly 的反斜杠被吞掉，克隆副本落进仓库工作区
Programdistilly/
D*ProjectAllAgentBASEgit_pull_result.txt

# -- 运行噪音：宿主 / 工具在 cwd 顺手写下的日志 --
# 实测：搜狗输入法会把 `debug.log` 写进当前目录
debug.log
