# Git 忽略规则

# ============================================
# 操作系统生成的文件
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ============================================
# 编辑器和 IDE
# ============================================
# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains 系列（PyCharm, WebStorm 等）
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ============================================
# 编程语言相关
# ============================================
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/
*.egg

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Java
*.class
*.jar
*.war
target/

# C/C++
*.o
*.obj
*.exe
*.out
*.so
*.dll

# ============================================
# 项目配置和敏感信息
# ============================================
# 环境变量文件
.env
.env.local
.env.*.local

# 配置文件（可能包含密码）
config.local.*
secrets.json
credentials.json

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 日志文件
*.log
logs/
log/

# ============================================
# 临时文件和缓存
# ============================================
# 临时文件夹
temp/
tmp/
cache/
.cache/

# 备份文件
*.bak
*.backup
*.old

# ============================================
# 构建产物
# ============================================
# 编译输出
dist/
build/
out/
*.min.js
*.min.css

# ============================================
# 测试相关
# ============================================
# 测试覆盖率报告
coverage/
.nyc_output/
htmlcov/
.coverage

# ============================================
# 其他
# ============================================
# 压缩文件（根据需要调整）
# *.zip
# *.rar
# *.7z

# 大文件（根据需要调整）
# *.mp4
# *.avi
# *.mov
